# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_TOKEN=coloca_aqui_tu_token_permanente_o_temporal
WHATSAPP_PHONE_NUMBER_ID=coloca_aqui_el_phone_number_id
WHATSAPP_VERIFY_TOKEN=elige_una_palabra_secreta_para_el_webhook
GRAPH_API_VERSION=v20.0

# --- Base de datos (SQL Server) ---
DB_SERVER=localhost
DB_NAME=ClinicaEcheverria
DB_USER=sa
DB_PASSWORD=coloca_aqui_la_clave
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=true

# --- Servidor ---
PORT=3000
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Correo (para el reporte diario a los doctores) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=reportes@clinicaecheverria.com
SMTP_PASS=coloca_aqui_la_clave_o_app_password
SMTP_FROM="Clínica Echeverría <reportes@clinicaecheverria.com>"

# --- Power BI (opcional, para disparar el refresh del dataset) ---
POWERBI_ENABLED=false
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
